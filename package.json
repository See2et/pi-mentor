{
  "name": "pi-mentor",
  "version": "0.1.0",
  "private": true,
  "description": "User-directed learning workflow for Pi",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "prepare": "bun --bun husky",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun --bun vitest run",
    "architecture": "bun --bun depcruise --config .dependency-cruiser.cjs src index.ts",
    "lint": "bun --bun oxlint src",
    "format": "bun --bun oxfmt .",
    "format:check": "bun --bun oxfmt --check .",
    "precommit": "bun --bun lint-staged",
    "check": "pnpm run typecheck && pnpm run architecture && pnpm run lint && pnpm test"
  },
  "dependencies": {
    "neverthrow": "8.2.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@types/node": "^24.0.0",
    "dependency-cruiser": "18.7.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.3",
    "vitest": "4.1.12"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "bun --bun oxfmt",
      "bun --bun oxlint"
    ],
    "*.{json,md,yaml,yml}": "bun --bun oxfmt"
  },
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
