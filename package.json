{
  "name": "pi-mentor",
  "version": "0.1.0",
  "private": true,
  "description": "User-directed learning workflow for Pi",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "architecture": "depcruise --config .dependency-cruiser.cjs src index.ts",
    "lint": "oxlint src",
    "check": "npm run typecheck && npm run architecture && npm run lint && npm test"
  },
  "dependencies": {
    "neverthrow": "8.2.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@types/node": "^24.0.0",
    "dependency-cruiser": "18.7.2",
    "oxlint": "1.91.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.3",
    "vitest": "4.1.12"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "overrides": {
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-codemode": "1.0.4",
    "@earendil-works/pi-mcp": "1.0.4"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
